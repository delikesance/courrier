{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Courrier",
  "version": "0.2.1",
  "identifier": "dev.angeloclauin.courrier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Courrier", "width": 1180, "height": 760, "minWidth": 760, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' about: data: blob:; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"] }
}

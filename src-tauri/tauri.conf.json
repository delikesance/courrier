{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Courrier",
  "version": "0.3.0",
  "identifier": "dev.angeloclauin.courrier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Courrier",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' about: data: blob:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOEQ1QkJCMkMxODQ0MzkKUldRNVJCZ3N1MXVOL08xL0ZmaXVucVVzT21pOWxXZG1ZaXh4UFZ2THhueHJmSDlDRTExRDVvV1kK",
      "endpoints": [
        "https://github.com/delikesance/courrier/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}